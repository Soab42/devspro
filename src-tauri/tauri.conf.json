{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevsPro",
  "version": "0.1.0",
  "identifier": "com.soab.devspro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevsPro",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "soab42",
    "copyright": "Copyright (c) 2026 soab42",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/Soab42/devspro",
    "category": "DeveloperTool",
    "shortDescription": "Local development environment manager.",
    "longDescription": "DevsPro manages a local development environment from one window: nginx sites with locally-trusted HTTPS, Docker containers, databases, background workers, a mail catcher, log tails, and listening ports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ldm-helper"],
    "linux": {
      "deb": {
        "depends": ["pkexec | policykit-1"],
        "files": {
          "/usr/share/polkit-1/actions/com.soab.devspro.policy": "policy/com.soab.devspro.policy"
        }
      },
      "rpm": {
        "depends": ["polkit"],
        "files": {
          "/usr/share/polkit-1/actions/com.soab.devspro.policy": "policy/com.soab.devspro.policy"
        }
      }
    }
  }
}
