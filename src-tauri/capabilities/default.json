{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, popped-out module windows, popped-out browser tabs and popped-out terminals",
  "windows": ["main", "module-*", "browser-tab-*", "term-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default"
  ]
}
